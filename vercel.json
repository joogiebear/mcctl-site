{
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mcctl-site.vercel.app"
        }
      ],
      "destination": "https://www.spawnloft.com/$1",
      "permanent": true
    },
    {
      "source": "/get-started",
      "destination": "/download",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/descent",
      "destination": "/lab/descent",
      "permanent": true
    }
  ]
}
