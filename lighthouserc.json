{
  "ci": {
    "collect": {
      "staticDistDir": ".vitepress/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/download.html",
        "http://localhost/changelog.html",
        "http://localhost/guide/getting-started.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "is-on-https",
          "redirects-http",
          "canonical"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/(download|changelog|guide/).*",
          "assertions": {
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ],
            "resource-summary:third-party:count": [
              "warn",
              {
                "maxNumericValue": 1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/index.html$",
          "assertions": {
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
